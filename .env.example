# ZailTrack Environment Variables

# URL Database PostgreSQL / Neon / Vercel Postgres
# Dapatkan gratis 1 klik di neon.tech atau dashboard Vercel Storage -> Postgres
DATABASE_URL="postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key (rahasia untuk menandatangani token sesi login)
# Buat string acak panjang (misal: openssl rand -base64 32)
JWT_SECRET="zailtrack-super-secret-jwt-key-change-this-in-production-min-32-chars"
